{
	"extends": ["eslint:recommended"],
	"parser": "@typescript-eslint/parser",
	"plugins": ["@typescript-eslint"],
	"ignorePatterns": ["dist/**", "release/**", "node_modules/**", "scripts/**", "src/main/**"],
	"env": {
		"browser": true,
		"node": true,
		"es2021": true
	},
	"rules": {
		"no-console": "off",
		"no-unused-vars": "off",
		"@typescript-eslint/no-unused-vars": "off",
		"no-undef": "off",
		"no-useless-escape": "off"
	}
}
